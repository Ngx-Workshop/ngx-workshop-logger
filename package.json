{
  "name": "ngx-workshop-logger",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Angular logging for Ngx-Workshop shells and microfrontends",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build ngx-workshop-logger --configuration production",
    "watch": "ng build ngx-workshop-logger --watch --configuration development",
    "ngx-workshop-logger:build": "npm run build",
    "ngx-workshop-logger:watch": "npm run watch",
    "start": "npm run build && npm run demo:serve",
    "demo:serve": "ng serve ngx-workshop-logger-demo",
    "demo:watch": "npm run demo:serve",
    "demo:build": "npm run build && ng build ngx-workshop-logger-demo --configuration production",
    "demo:build:pages": "npm run demo:build -- --base-href=/ngx-workshop-logger/",
    "test": "ng test ngx-workshop-logger --watch=false",
    "test:watch": "ng test ngx-workshop-logger",
    "check": "npm test && npm run demo:build",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@angular/common": "21.1.0",
    "@angular/compiler": "21.1.0",
    "@angular/core": "21.1.0",
    "@angular/platform-browser": "21.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.1.0",
    "@angular/cli": "21.1.0",
    "@angular/compiler-cli": "21.1.0",
    "ng-packagr": "21.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8",
    "jsdom": "^27.1.0"
  }
}
